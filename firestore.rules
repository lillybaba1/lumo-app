rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products - read all, write admin only
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories - read all, write admin only
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders - read own orders, create own, admin can do all
    match /orders/{orderId} {
      allow read: if isAdmin() ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Payments - admin only (sensitive financial data)
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Users - read own profile, admin can read all
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews - read all, create/update own, admin can moderate
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Wishlists - read/write own only
    match /wishlists/{wishlistId} {
      allow read, write: if isSignedIn() &&
                            resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Coupons - read all, write admin only
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings - read all, write admin only
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Content/Pages - read all, write admin only
    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
