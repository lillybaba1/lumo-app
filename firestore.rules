rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products - public read for shopping, admin-only write
    match /products/{productId} {
      allow read: if true; // Public catalog browsing
      allow write: if isAdmin(); // Only admins can manage products
    }

    // Categories - public read for shopping, admin-only write
    match /categories/{categoryId} {
      allow read: if true; // Public catalog browsing
      allow write: if isAdmin(); // Only admins can manage categories
    }

    // Orders - customers can only access their own, admins can access all
    match /orders/{orderId} {
      allow read: if isAdmin() ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin(); // Only admins can modify/delete orders
    }

    // Payments - admin-only access (sensitive financial data)
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Users - customers can only access their own profile, admins can access all
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }

    // Reviews - public read, customers can create/update only their own, admins can do all
    match /reviews/{reviewId} {
      allow read: if true; // Public reviews for products
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin(); // Only admins can delete reviews
    }

    // Wishlists - customers can only access their own, admins can access all
    match /wishlists/{wishlistId} {
      allow read: if isAdmin() ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() ||
                               (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Coupons - public read for applying discounts, admin-only write
    match /coupons/{couponId} {
      allow read: if true; // Customers need to apply coupons at checkout
      allow write: if isAdmin(); // Only admins can manage coupons
    }

    // Settings - public read for theme/config, admin-only write
    match /settings/{doc} {
      allow read: if true; // Public access to site settings/theme
      allow write: if isAdmin(); // Only admins can change settings
    }

    // Content/Pages - public read for CMS pages, admin-only write
    match /content/{doc} {
      allow read: if true; // Public access to CMS content
      allow write: if isAdmin(); // Only admins can edit content
    }
  }
}
