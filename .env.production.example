# Production Environment Variables for Vercel Deployment
# Copy these to Vercel Dashboard → Settings → Environment Variables

# ============================================
# Supabase Configuration (Required)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Google AI API Key (Required for AI features)
# Get from https://aistudio.google.com
# ============================================
GOOGLE_API_KEY=
# Alternative env name accepted by src/ai/genkit.ts:
# GEMINI_API_KEY=

# ============================================
# OpenAI (Optional fallback for AI)
# ============================================
# OPENAI_API_KEY=

# ============================================
# Email (Zoho SMTP) - used by src/lib/email.ts
# ============================================
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
