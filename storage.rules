rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024; // 5MB max
    }

    // Product images - public read, admin-only write
    match /products/{productId}/{allPaths=**} {
      allow read: if true; // Public access to product images
      allow write: if isAdmin() && isValidImage(); // Only admins can manage product images
    }

    // User uploads - customers can only access their own files, admins can access all
    match /uploads/{userId}/{allPaths=**} {
      allow read: if isAdmin() || request.auth.uid == userId; // Users can read their own files
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidImage(); // Users can upload to their own folder
      allow update: if isAdmin() ||
                       (isSignedIn() && request.auth.uid == userId); // Users can update their own files
      allow delete: if isAdmin() ||
                       (isSignedIn() && request.auth.uid == userId); // Users can delete their own files
    }

    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
