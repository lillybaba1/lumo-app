# ============================================
# OpenAI API Key (REQUIRED for AI Assistant)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# This is required for the OpenAI assistant to work
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Supabase Configuration
# ============================================
# Get these from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Google Gemini (alternative to OpenAI for the AI assistant)
# ============================================
# Get from https://aistudio.google.com/apikey
# GEMINI_API_KEY takes precedence over GOOGLE_API_KEY if both are set.
# You need EITHER these or OPENAI_API_KEY above, not both.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_ai_api_key_here

# ============================================
# Site URLs (REQUIRED)
# ============================================
# The public URL of this deployment, no trailing slash.
#
# NEXT_PUBLIC_SITE_URL is REQUIRED — it has no fallback on the signup path
# (src/app/api/auth/signup/route.ts). If unset, verification emails link to
# "undefined/auth/callback" and new users can never verify their accounts.
#
# Whatever you set here must also be registered in the Supabase dashboard under
# Authentication > URL Configuration (Site URL + Redirect URLs).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Used for seller notifications and checkout redirects. Falls back to
# https://julazone.com, which is wrong on any other domain — set it explicitly.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============================================
# Node Environment
# ============================================
NODE_ENV=production

# ============================================
# Zoho Email Configuration (for sending emails)
# ============================================
# Your Zoho email address (used as the sender)
ZOHO_EMAIL=noreply@yourdomain.com

# Your Zoho email password or app-specific password
# If you have 2FA enabled, generate an app-specific password from:
# https://accounts.zoho.com/home#security/security_pwd
ZOHO_PASSWORD=your_zoho_password_here

# SMTP Host (default: smtp.zoho.com for Zoho Mail)
# Use smtp.zoho.eu if you're on Zoho EU, smtp.zoho.in for India, etc.
ZOHO_SMTP_HOST=smtp.zoho.com

# SMTP Port (default: 465 for SSL, 587 for TLS)
ZOHO_SMTP_PORT=465

# From name displayed in emails
ZOHO_FROM_NAME=JulaZone


# ============================================
# Modem Pay (REQUIRED for payments & seller payouts)
# ============================================
# Get keys from the Modem Pay dashboard. The webhook secret is REQUIRED in
# production — without it the webhook endpoint refuses all events.
MODEMPAY_PUBLIC_KEY=your_modempay_public_key_here
MODEMPAY_SECRET_KEY=your_modempay_secret_key_here
MODEMPAY_WEBHOOK_SECRET=your_modempay_webhook_secret_here
# Same value as MODEMPAY_PUBLIC_KEY — the browser checkout reads this one.
NEXT_PUBLIC_MODEMPAY_PUBLIC_KEY=your_modempay_public_key_here

# ============================================
# PayDunya (OPTIONAL — alternative payment provider)
# ============================================
# Leave unset if you only use Modem Pay. The /api/payments/paydunya route
# returns an error when these are missing; nothing else is affected.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# "test" or "live"
PAYDUNYA_MODE=test

# ============================================
# Redis / Upstash (OPTIONAL — rate limiting)
# ============================================
# Without these the rate limiter falls back to in-memory counters, which are
# per-instance and therefore close to useless on serverless. Set them in
# production. UPSTASH_* names are accepted as aliases.
REDIS_URL=
REDIS_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ============================================
# Misc (OPTIONAL)
# ============================================
# Name of the auth session cookie. Defaults to "session".
SESSION_COOKIE_NAME=session
